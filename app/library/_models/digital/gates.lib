Xa vc gn a da bench_din LO={LO} HI={HI} RK={RK} AK={AK} TD={TD}
Xb vc gn b db bench_din LO={LO} HI={HI} RK={RK} AK={AK} TD={TD}
A1 [da db] dy g
.model g d_or(rise_delay={TPD} fall_delay={TPD})
Xo vc gn dy y bench_dout VOLF={VOLF} VOHF={VOHF} ROUT={ROUT} TD={TD}
.ends bench_d_or2
.subckt bench_d_xor2 vc gn a b y params: LO=0.45 HI=0.55 RK=1 AK=0 VOLF=0 VOHF=1 ROUT=45 TPD=9n TD=1n
Xa vc gn a da bench_din LO={LO} HI={HI} RK={RK} AK={AK} TD={TD}
Xb vc gn b db bench_din LO={LO} HI={HI} RK={RK} AK={AK} TD={TD}
A1 [da db] dy g
.model g d_xor(rise_delay={TPD} fall_delay={TPD})
Xo vc gn dy y bench_dout VOLF={VOLF} VOHF={VOHF} ROUT={ROUT} TD={TD}
